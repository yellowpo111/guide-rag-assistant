DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_TIMEOUT_SECONDS=60
DASHSCOPE_EMBEDDING_MAX_RETRIES=0
# qwen3-rerank requires its own workspace-compatible base URL. It may be the
# full .../compatible-api/v1 base or the full .../compatible-api/v1/reranks endpoint.
DASHSCOPE_RERANK_BASE_URL=
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_RERANK_TIMEOUT_SECONDS=60
DASHSCOPE_RERANK_MAX_RETRIES=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=0

# Internal HTTP service settings.
FISCAL_RAG_HOST=127.0.0.1
FISCAL_RAG_PORT=8000
FISCAL_RAG_LOG_LEVEL=INFO
# Optional absolute paths; defaults point to data_private/corpus and the
# existing fiscal_guides_chroma_v1 index below the project directory.
FISCAL_RAG_CORPUS_DIR=
FISCAL_RAG_INDEX_DIR=
# Private structured usage records. Keep this separate from the Chroma index.
FISCAL_RAG_USAGE_DB_PATH=
FISCAL_RAG_USAGE_RETENTION_DAYS=90
